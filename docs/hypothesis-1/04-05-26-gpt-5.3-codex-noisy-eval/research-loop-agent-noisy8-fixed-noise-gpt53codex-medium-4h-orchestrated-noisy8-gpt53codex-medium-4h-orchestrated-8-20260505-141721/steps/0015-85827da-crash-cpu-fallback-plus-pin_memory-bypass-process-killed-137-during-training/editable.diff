+runtime_device = CONFIG.device
+if CONFIG.device == "cuda":
+    try:
+        wait_for_cuda_or_fail()
+    except Exception as exc:
+        print(f"CUDA unavailable ({exc}); falling back to CPU")
+        runtime_device = "cpu"
+
+device = torch.device(runtime_device)
