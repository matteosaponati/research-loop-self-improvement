-device = torch.device(CONFIG.device)
+
+def resolve_runtime_device():
+    requested = CONFIG.device
+    if requested == "cuda":
+        if not torch.cuda.is_available():
+            print("WARN: CUDA requested but unavailable; falling back to CPU.")
+            return torch.device("cpu"), "cpu"
+        try:
+            torch.cuda.manual_seed(CONFIG.seed)
+            _ = torch.empty(1, device="cuda")
+            return torch.device("cuda"), "cuda"
+        except Exception as exc:
+            print(f"WARN: CUDA requested but unusable ({exc}); falling back to CPU.")
+            return torch.device("cpu"), "cpu"
+    return torch.device(requested), requested
+
+device, runtime_device_type = resolve_runtime_device()
 autocast_dtype = getattr(torch, CONFIG.autocast_dtype)
-autocast_ctx = torch.amp.autocast(device_type=CONFIG.device, dtype=autocast_dtype)
+if runtime_device_type == "cuda":
+    autocast_ctx = torch.amp.autocast(device_type="cuda", dtype=autocast_dtype)
+else:
+    autocast_ctx = torch.amp.autocast(device_type="cpu", enabled=False)
+
+def sync_if_cuda():
+    if runtime_device_type == "cuda":
+        torch.cuda.synchronize()
+
+if runtime_device_type == "cpu":
+    _torch_empty = torch.empty
+    def empty_without_pin_memory(*args, **kwargs):
+        kwargs.pop("pin_memory", None)
+        return _torch_empty(*args, **kwargs)
+    torch.empty = empty_without_pin_memory
 
