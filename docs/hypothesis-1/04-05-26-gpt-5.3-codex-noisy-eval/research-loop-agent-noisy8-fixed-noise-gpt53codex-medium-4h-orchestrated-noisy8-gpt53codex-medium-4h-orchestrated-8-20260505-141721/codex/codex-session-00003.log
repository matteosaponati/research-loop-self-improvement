             print(f"CUDA not available; retrying in {CUDA_WAIT_POLL_SECONDS}s, {remaining}s left")
         time.sleep(CUDA_WAIT_POLL_SECONDS)
 
+
+@contextmanager
+def disable_pin_memory_empty():
+    """Temporarily strip pin_memory=True from torch.empty calls."""
+    orig_empty = torch.empty
+
+    def empty_no_pin(*args, **kwargs):
+        if kwargs.get("pin_memory"):
+            kwargs["pin_memory"] = False
+        return orig_empty(*args, **kwargs)
+
+    torch.empty = empty_no_pin
+    try:
+        yield
+    finally:
+        torch.empty = orig_empty
+
 wait_for_cuda_or_fail()
 device = torch.device(CONFIG.device)
 autocast_dtype = getattr(torch, CONFIG.autocast_dtype)
