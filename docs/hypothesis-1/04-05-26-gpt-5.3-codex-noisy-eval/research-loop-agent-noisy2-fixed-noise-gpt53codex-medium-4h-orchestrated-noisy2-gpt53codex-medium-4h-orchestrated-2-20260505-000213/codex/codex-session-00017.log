mem=float(m['peak_vram_mb'])/1024.0
best=None
p=Path('memory/results.tsv')
for i,line in enumerate(p.read_text().splitlines()):
    if i==0 or not line.strip():
        continue
    parts=line.split('\\t')
    if len(parts)<5:
        continue
    try:
        v=float(parts[1])
    except:
        continue
    if best is None or v<best:
        best=v
status='keep' if (best is None or val<best) else 'discard'
desc='lower muon beta2 to 0.93'
with p.open('a') as f:
    f.write(f\"{commit}\\t{val:.6f}\\t{mem:.1f}\\t{status}\\t{desc}\\n\")
print(json.dumps({'commit':commit,'val_bpb':val,'memory_gb':round(mem,1),'best_before':best,'status':status}, indent=2))
