mem=float(m['peak_vram_mb'])/1024.0
# read previous best from results.tsv excluding header and non-numeric safety
best=None
p=Path('memory/results.tsv')
for i,line in enumerate(p.read_text().splitlines()):
    if i==0 or not line.strip():
        continue
    parts=line.split('\\t')
    if len(parts)<5:
        continue
    try:
        v=float(parts[1])
