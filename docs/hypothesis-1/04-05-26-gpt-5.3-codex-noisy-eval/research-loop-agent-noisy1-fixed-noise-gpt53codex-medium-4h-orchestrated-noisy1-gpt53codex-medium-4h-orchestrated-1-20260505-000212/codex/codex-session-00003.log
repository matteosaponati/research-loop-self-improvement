        sequence_len=runtime_sequence_len,
        buffer_size=CONFIG.dataloader_buffer_size,
        tokenizer_batch_size=CONFIG.tokenizer_batch_size,
        device=runtime_device,
    )

# Final summary
t_end = time.time()
startup_time = t_start_training - t_start
timed_steps = step - WARMUP_STEPS_EXCLUDED_FROM_TIMING
steady_state_mfu = 100 * num_flops_per_token * runtime_total_batch_size * timed_steps / total_training_time / CONFIG.h100_bf16_peak_flops if total_training_time > 0 else 0
peak_vram_mb = torch.cuda.max_memory_allocated() / 1024 / 1024 if runtime_device == "cuda" else 0.0
metrics = {
