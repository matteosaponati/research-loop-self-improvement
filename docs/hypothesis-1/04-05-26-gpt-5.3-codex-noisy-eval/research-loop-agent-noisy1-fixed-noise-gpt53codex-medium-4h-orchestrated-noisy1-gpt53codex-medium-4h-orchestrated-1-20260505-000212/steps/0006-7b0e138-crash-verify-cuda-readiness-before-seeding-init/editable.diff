+if CONFIG.device == "cuda" and not cuda_ready:
+    runtime_device = "cpu"
+    print("WARN: CUDA unavailable at runtime; falling back to CPU.")
 device = torch.device(runtime_device)
 autocast_ctx = (
     torch.amp.autocast(device_type=runtime_device, dtype=autocast_dtype)
