495:        return progress / CONFIG.warmup_ratio if CONFIG.warmup_ratio > 0 else 1.0
496:    elif progress < 1.0 - CONFIG.warmdown_ratio:
499:        cooldown = (1.0 - progress) / CONFIG.warmdown_ratio
500:        return cooldown * 1.0 + (1 - cooldown) * CONFIG.final_lr_frac
502:def get_muon_momentum(step):
503:    frac = min(step / CONFIG.muon_momentum_warmup_steps, 1)
504:    return (1 - frac) * CONFIG.muon_momentum_start + frac * CONFIG.muon_momentum_end
506:def get_weight_decay(progress):
507:    return CONFIG.weight_decay * (1 - progress) if CONFIG.weight_decay_decay else CONFIG.weight_decay
513:t_start_training = time.time()
514:smooth_train_loss = 0
515:total_training_time = 0
523:            loss = model(x, y)
524:        train_loss = loss.detach()
525:        loss = loss / grad_accum_steps
526:        loss.backward()
527:        x, y, epoch = next(train_loader)
529:    # Progress and schedules
530:    progress = min(total_training_time / TIME_BUDGET_SECONDS, 1.0)
531:    lrm = get_lr_multiplier(progress)
532:    muon_momentum = get_muon_momentum(step)
533:    muon_weight_decay = get_weight_decay(progress)
534:    for group in optimizer.param_groups:
535:        group["lr"] = group["initial_lr"] * lrm
537:            group["momentum"] = muon_momentum
538:            group["weight_decay"] = muon_weight_decay
539:    optimizer.step()
542:    train_loss_f = train_loss.item()
544:    # Fast fail: abort if loss is exploding or NaN
545:    if math.isnan(train_loss_f) or train_loss_f > LOSS_FAIL_THRESHOLD:
554:        total_training_time += dt
558:    smooth_train_loss = ema_beta * smooth_train_loss + (1 - ema_beta) * train_loss_f
559:    debiased_smooth_loss = smooth_train_loss / (1 - ema_beta**(step + 1))
561:    tok_per_sec = int(CONFIG.total_batch_size / dt)
562:    mfu = 100 * num_flops_per_token * CONFIG.total_batch_size / dt / CONFIG.h100_bf16_peak_flops
563:    remaining = max(0, TIME_BUDGET_SECONDS - total_training_time)
565:    print(f"\rstep {step:05d} ({pct_done:.1f}%) | loss: {debiased_smooth_loss:.6f} | lrm: {lrm:.2f} | dt: {dt*1000:.0f}ms | tok/sec: {tok_per_sec:,} | mfu: {mfu:.1f}% | epoch: {epoch} | remaining: {remaining:.0f}s    ", end="", flush=True)
