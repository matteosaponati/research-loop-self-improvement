/bin/bash -lc "uv run --extra research python - <<'PY'
import json, subprocess
from pathlib import Path
m=json.load(open('metrics.json'))
commit=subprocess.check_output(['git','rev-parse','--short=7','HEAD'], text=True).strip()
rows=Path('memory/results.tsv').read_text().strip().splitlines()[1:]
best=min(float(r.split('\\t')[1]) for r in rows if r.split('\\t')[3]=='keep')
status='keep' if m['val_bpb'] < best else 'discard'
mem=m.get('peak_vram_mb',0)/1024
with open('memory/results.tsv','a') as f:
    f.write(f\"{commit}\\t{m['val_bpb']:.6f}\\t{mem:.1f}\\t{status}\\tdouble total batch without qk norm\\n\")
