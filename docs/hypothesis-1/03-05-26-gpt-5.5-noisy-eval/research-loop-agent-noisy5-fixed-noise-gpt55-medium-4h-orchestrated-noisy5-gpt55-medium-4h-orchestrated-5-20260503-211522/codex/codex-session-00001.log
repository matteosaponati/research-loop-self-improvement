    model_dim = ((base_dim + CONFIG.head_dim - 1) // CONFIG.head_dim) * CONFIG.head_dim
    num_heads = model_dim // CONFIG.head_dim
    return GPTConfig(
        sequence_len=CONFIG.sequence_len, vocab_size=vocab_size,
