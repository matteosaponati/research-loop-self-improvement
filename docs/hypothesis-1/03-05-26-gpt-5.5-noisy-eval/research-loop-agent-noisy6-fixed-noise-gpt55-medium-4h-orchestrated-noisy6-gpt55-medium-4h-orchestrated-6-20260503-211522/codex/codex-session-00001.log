import json, subprocess
from pathlib import Path
m=json.load(open('metrics.json'))
commit=subprocess.check_output(['git','rev-parse','--short=7','HEAD'], text=True).strip()
kept=[]
for line in Path('memory/results.tsv').read_text().splitlines()[1:]:
    if not line.strip(): continue
    c,val,mem,status,desc=line.split('\\t',4)
    if status=='keep': kept.append(float(val))
best=min(kept) if kept else float('inf')
status='keep' if m['val_bpb'] < best else 'discard'
