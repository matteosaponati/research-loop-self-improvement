print(f\"best_prev={best:.6f}\")
print(line, end='')
print(f\"num_steps={m['num_steps']} total_tokens_M={m['total_tokens_M']:.1f} mfu={m['mfu_percent']:.2f} params_M={m['num_params_M']:.1f}\")
