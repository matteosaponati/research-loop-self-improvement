kept=[]
for line in Path('memory/results.tsv').read_text().splitlines()[1:]:
    if not line.strip(): continue
    c,val,mem,status,desc=line.split('\\t',4)
    if status=='keep': kept.append(float(val))
best=min(kept) if kept else float('inf')
status='keep' if m['val_bpb'] < best else 'discard'
mem=m.get('peak_vram_mb',0)/1024
line=f\"{commit}\\t{m['val_bpb']:.6f}\\t{mem:.1f}\\t{status}\\tdepth 11 init matrix scale 2.0\\n\"
with open('memory/results.tsv','a') as f: f.write(line)
print(f\"best_prev={best:.6f}\")
print(line, end='')
print(f\"num_steps={m['num_steps']} total_tokens_M={m['total_tokens_M']:.1f} mfu={m['mfu_percent']:.2f} params_M={m['num_params_M']:.1f}\")
