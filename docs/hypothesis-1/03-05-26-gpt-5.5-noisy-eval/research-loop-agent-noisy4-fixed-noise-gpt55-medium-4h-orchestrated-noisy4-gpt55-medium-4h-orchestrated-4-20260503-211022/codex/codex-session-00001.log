    f.write(f\"{commit}\\t{m['val_bpb']:.6f}\\t{mem:.1f}\\t{status}\\tdepth 9 mlp 3 warmdown 0.3\\n\")
print(json.dumps({'commit':commit,'best_before':best,'status':status,**m}, sort_keys=True))
