/bin/bash -lc "uv run python - <<'PY'
import json, subprocess
from pathlib import Path
m=json.loads(Path('metrics.json').read_text())
commit=subprocess.check_output(['git','rev-parse','--short=7','HEAD'], text=True).strip()
best=999.0
rows=Path('memory/results.tsv').read_text().strip().splitlines()[1:]
for r in rows:
    parts=r.split('\\t')
    if len(parts)>=4 and parts[3]=='keep':
        best=min(best, float(parts[1]))
status='keep' if m['val_bpb'] < best else 'discard'
mem=m.get('peak_vram_mb',0)/1024
line=f\"{commit}\\t{m['val_bpb']:.6f}\\t{mem:.1f}\\t{status}\\tshorter warmdown with nonzero final LR\\n\"
with open('memory/results.tsv','a') as f: f.write(line)
