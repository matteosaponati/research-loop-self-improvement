commit=subprocess.check_output(['git','rev-parse','--short=7','HEAD'], text=True).strip()
best=999.0
for r in Path('memory/results.tsv').read_text().strip().splitlines()[1:]:
    parts=r.split('\\t')
    if len(parts)>=4 and parts[3]=='keep':
        best=min(best, float(parts[1]))
status='keep' if m['val_bpb'] < best else 'discard'
line=f\"{commit}\\t{m['val_bpb']:.6f}\\t{m.get('peak_vram_mb',0)/1024:.1f}\\t{status}\\tuse squared SiLU MLP activation\\n\"
with open('memory/results.tsv','a') as f: f.write(line)
print(line, end='')
print(f\"best_before\\t{best:.6f}\")
