+    """Approximate the orthogonal factor of a batch of matrices in bf16."""
+    assert g.ndim >= 2
+    a, b, c = 3.4445, -4.7750, 2.0315
+    x = g.bfloat16()
+    transpose = g.size(-2) > g.size(-1)
+    if transpose:
+        x = x.mT
+    x = x / (x.norm(dim=(-2, -1), keepdim=True) + 1e-7)
+    for _ in range(steps):
