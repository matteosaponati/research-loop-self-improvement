+@torch.compile
+def zeropower_via_newtonschulz5(g, steps=MUON_NS_STEPS):
+    """Approximate the orthogonal factor of a batch of matrices in bf16."""
+    assert g.ndim >= 2
+    a, b, c = 3.4445, -4.7750, 2.0315
+    x = g.bfloat16()
+    transpose = g.size(-2) > g.size(-1)
+    if transpose:
+        x = x.mT
+    x = x / (x.norm(dim=(-2, -1), keepdim=True) + 1e-7)
+    for _ in range(steps):
+        a_mat = x @ x.mT
+        b_mat = b * a_mat + c * (a_mat @ a_mat)
+        x = a * x + b_mat @ x
+    if transpose:
+        x = x.mT
+    return x
+
+
+class BatchedMuon(torch.optim.Optimizer):
+    """Single-device Muon with same-shaped matrices orthogonalized together."""
+    def __init__(self, params, lr, momentum=MUON_MOMENTUM, weight_decay=0.0):
+        super().__init__(params, dict(lr=lr, momentum=momentum, weight_decay=weight_decay))
+
+    @torch.no_grad()
+    def step(self, closure=None):
+        loss = None
+        if closure is not None:
+            with torch.enable_grad():
+                loss = closure()
+        for group in self.param_groups:
+            by_shape = {}
+            beta = group["momentum"]
+            for parameter in group["params"]:
+                if parameter.grad is None:
+                    continue
+                assert parameter.ndim == 2
+                state = self.state[parameter]
+                if "momentum_buffer" not in state:
+                    state["momentum_buffer"] = torch.zeros_like(parameter)
+                momentum = state["momentum_buffer"]
+                momentum.lerp_(parameter.grad, 1 - beta)
+                update = parameter.grad.lerp(momentum, beta)
+                by_shape.setdefault(parameter.shape, []).append((parameter, update))
+
+            for shape_group in by_shape.values():
+                updates = torch.stack([update for _, update in shape_group])
+                updates = zeropower_via_newtonschulz5(updates)
+                rows, cols = shape_group[0][0].shape
+                updates.mul_(max(1.0, rows / cols) ** 0.5)
+                for (parameter, _), update in zip(shape_group, updates):
+                    parameter.mul_(1 - group["lr"] * group["weight_decay"])
+                    parameter.add_(update, alpha=-group["lr"])
+        return loss
+
+
+class CombinedOptimizer:
+    def __init__(self, optimizers):
+        self.optimizers = optimizers
+        self.param_groups = [group for optimizer in optimizers for group in optimizer.param_groups]
+
+    def step(self):
+        for optimizer in self.optimizers:
+            optimizer.step()
+
