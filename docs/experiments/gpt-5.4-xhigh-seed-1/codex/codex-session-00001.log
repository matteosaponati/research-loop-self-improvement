+        b_mat = b * a_mat + c * (a_mat @ a_mat)
+        x = a * x + b_mat @ x
+    if transpose:
+        x = x.mT
+    return x
+
+
+class BatchedMuon(torch.optim.Optimizer):
+    """Single-device Muon with same-shaped matrices orthogonalized together."""
+    def __init__(self, params, lr, momentum=MUON_MOMENTUM, weight_decay=0.0):
+        super().__init__(params, dict(lr=lr, momentum=momentum, weight_decay=weight_decay))
