        "mfu_percent": float(steady_state_mfu),
        "total_tokens_M": float(total_tokens / 1e6),
        "num_steps": int(step),
        "num_params_M": float(num_params / 1e6),
        "depth": int(CONFIG.depth),
    }
    return TrainingResult(
        model=raw_model,
        tokenizer=tokenizer,
        model_config=config,
        training_metrics=metrics,
    )


