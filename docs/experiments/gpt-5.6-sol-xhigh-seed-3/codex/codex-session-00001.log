+@torch.compile
+def zeropower_via_newton_schulz5(matrix, steps):
+    """Approximate polar factors for one matrix or a batch of matrices."""
+    assert matrix.ndim >= 2
+    a, b, c = (3.4445, -4.7750, 2.0315)
+    x = matrix.bfloat16()
+    transposed = x.size(-2) > x.size(-1)
+    if transposed:
+        x = x.mT
+    x = x / (x.norm(dim=(-2, -1), keepdim=True) + 1e-7)
+    for _ in range(steps):
+        gram = x @ x.mT
+        x = a * x + (b * gram + c * gram @ gram) @ x
+    return x.mT if transposed else x
+
+
+class Muon(torch.optim.Optimizer):
+    """Momentum optimizer with orthogonalized updates for 2D matrices."""
+
+    def __init__(self, params, lr, weight_decay, momentum, nesterov, ns_steps):
+        defaults = dict(
+            lr=lr,
+            weight_decay=weight_decay,
+            momentum=momentum,
+            nesterov=nesterov,
+            ns_steps=ns_steps,
+        )
+        super().__init__(params, defaults)
+
+    @torch.no_grad()
+    def step(self):
+        for group in self.param_groups:
+            lr = group["lr"]
+            momentum = group["momentum"]
+            updates_by_shape = {}
+            for param in group["params"]:
+                if param.grad is None:
+                    continue
+                grad = param.grad
+                assert grad.ndim == 2
+                state = self.state[param]
+                if "momentum_buffer" not in state:
+                    state["momentum_buffer"] = torch.zeros_like(grad)
+                buffer = state["momentum_buffer"]
+                buffer.lerp_(grad, 1 - momentum)
+                update = grad.lerp(buffer, momentum) if group["nesterov"] else buffer
+                updates_by_shape.setdefault(grad.shape, []).append((param, update))
+            for shape, param_updates in updates_by_shape.items():
+                update_batch = torch.stack([update for _, update in param_updates])
+                update_batch = zeropower_via_newton_schulz5(update_batch, group["ns_steps"])
+                scale = max(1.0, shape[0] / shape[1]) ** 0.5
+                for (param, _), update in zip(param_updates, update_batch):
+                    param.mul_(1 - lr * group["weight_decay"])
+                    param.add_(update, alpha=-lr * scale)
+
+
