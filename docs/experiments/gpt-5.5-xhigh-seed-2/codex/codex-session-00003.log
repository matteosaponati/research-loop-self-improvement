                betas=adam_betas,
                eps=adam_eps,
                weight_decay=0.0,
            ),
            dict(
                params=embedding_params,
                lr=embedding_lr * dmodel_lr_scale,
                betas=adam_betas,
                eps=adam_eps,
                weight_decay=0.0,
